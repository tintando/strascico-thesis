# Cloudflare Pages response headers, mirroring deploy/nginx.conf. Pages already
# revalidates everything by default (max-age=0, must-revalidate), which covers
# index.html and sw.js, so only the hashed assets get a Cache-Control of their
# own. It is not set on /* as well: Pages joins a header matched by two rules
# into one comma-separated value.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Every asset filename carries its content hash, so it can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
